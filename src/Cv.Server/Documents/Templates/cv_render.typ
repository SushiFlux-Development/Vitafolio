// The CV on its own pages. The standalone CV and the application dossier both go through here, so they always produce the same CV.
// `cv-designs` (id to design) is generated by the server from its one list of designs. A design has two parts: `page` gives the page
// setup for the options (margins, background on every page) and `body` sets the content from the CV model.
#let cv-document(design, data, o, photo, numbering: none) = {
  let d = cv-designs.at(design)
  let m = cv-model(data, o, photo)
  let pg = (d.page)(o)
  [
    #show cv-break-mark: box(width: 0pt)
    #set text(font: o.fonts, size: 9pt, fill: rgb("#475569"), lang: o.lang)
    #set page(paper: "a4", margin: pg.margin, header: none, footer: none, background: pg.at("background", default: none), foreground: d.at("foreground", default: (m, o) => none)(m, o), numbering: numbering)
    #(d.body)(m, o)
  ]
}
