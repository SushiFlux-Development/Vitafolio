<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The server: API, accounts and sign-in, SQLite database, backups and hosting of the built web UI.
    Used by its own Program.cs (Docker, development) and in-process by the Windows program through ServerApp.Build.
  -->
  <PropertyGroup>
    <RootNamespace>Cv.Server</RootNamespace>
    <AssemblyName>Cv.Server</AssemblyName>
    <AssemblyTitle>$(Product) Server</AssemblyTitle>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="typstsharp" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cv.Server.Tests" />
    <!-- The public repository from branding.json, read at run time by Branding.Repository -->
    <AssemblyMetadata Include="Repository" Value="$(CvRepository)" Condition="'$(CvRepository)' != ''" />
    <AssemblyMetadata Include="PreviousCompanies" Value="$(CvPreviousCompanies)" Condition="'$(CvPreviousCompanies.Trim())' != ''" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Documents\Templates\*.typ" />
    <!-- The fonts documents are rendered with (SIL OFL, licence texts included). Shipped next to the program, see DocumentFonts.Directory -->
    <Content Include="Documents\Fonts\**\*.ttf;Documents\Fonts\**\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
